# Copy this file to .env.deploy and fill in real values.
# .env.deploy is gitignored and is read only by the "deploy" and
# "backend-deploy" agents (.claude/agents/) — never by the running app.

# AWS credentials + frontend deploy target — used only by the "deploy" agent
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
CLOUDFRONT_DISTRIBUTION_ID=

# Backend server details — used only by the "backend-deploy" agent
SSH_HOST=
SSH_USER=
SSH_KEY_PATH=
REMOTE_APP_DIR=
RESTART_COMMAND=
